# Frontend dev server port (backend runs on :3000, which the dev proxy targets).
PORT=3001

# API base URL. Leave UNSET in local dev — requests go to relative paths and are
# proxied to the backend by CRA's "proxy" field. Set this when deploying the
# static bundle so the browser calls the real API origin directly.
# REACT_APP_API_URL=https://api.your-domain.com

# Block explorer base URL for tx/address links (defaults to Ethereum Sepolia).
# REACT_APP_EXPLORER_BASE_URL=https://sepolia.etherscan.io
